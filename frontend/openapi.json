{
  "openapi": "3.1.0",
  "info": {
    "title": "FestOS API",
    "description": "Internal command centre for the Aarohan fest (EPINOIA 2026, IIM Indore)",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get Health",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get Meta",
        "operationId": "get_meta_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/_example/items": {
      "post": {
        "tags": [
          "Example Flow"
        ],
        "summary": "Post Create Example Item",
        "operationId": "post_create_example_item_api_v1__example_items_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExampleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_ChangeResult_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeResult": {
        "properties": {
          "change_set_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Set Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "APPLIED",
              "PENDING_APPROVAL",
              "REJECTED",
              "DRY_RUN"
            ],
            "title": "Status"
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/Violation"
            },
            "type": "array",
            "title": "Violations"
          },
          "audit_event_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Audit Event Ids"
          },
          "impact": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Impact"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ChangeResult"
      },
      "CreateExampleRequest": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique ID for item"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Item name"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "default": "PARTICIPANT"
          },
          "age": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "is_high_risk": {
            "type": "boolean",
            "title": "Is High Risk",
            "default": false
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": false
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "CreateExampleRequest"
      },
      "EntityRef": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "type",
          "id",
          "label"
        ],
        "title": "EntityRef"
      },
      "Envelope_ChangeResult_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ChangeResult"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "Envelope[ChangeResult]"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Severity": {
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          4
        ],
        "title": "Severity"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Violation": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": 2
          },
          "hard": {
            "type": "boolean",
            "title": "Hard",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "entity_refs": {
            "items": {
              "$ref": "#/components/schemas/EntityRef"
            },
            "type": "array",
            "title": "Entity Refs"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "Violation"
      }
    }
  }
}