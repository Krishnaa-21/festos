# Database configuration (SQLite WAL by default, or Postgres)
DATABASE_URL=sqlite:///./festos.db

# Authentication and Security
JWT_SECRET=festos-dev-insecure-secret-key-change-in-production
JWT_EXPIRE_MIN=1440
AUTH_DISABLED=true
QR_SECRET=festos-dev-qr-verification-secret

# Time & Clock
FESTOS_TZ=Asia/Kolkata
# FESTOS_NOW=2026-10-30T10:00:00Z  # Optional override for simulated fest time

# Data & Seeding
DATA_DIR=./data
SEED_ON_START=false

# AI & Solver Integrations
LLM_PROVIDER=mock
LLM_API_KEY=
ACCOM_SOLVER=heuristic
SCHED_SOLVER=heuristic

# Feature Flags (Task 5: optional module toggles)
ENABLE_PREMORTEM=true
ENABLE_COMMANDS=true
ENABLE_FORECASTING=true

# Frontend & CORS
# Leave VITE_API_URL empty in Docker to use nginx's /api proxy.
VITE_API_URL=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:80","http://127.0.0.1:80"]
