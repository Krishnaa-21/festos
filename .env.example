# Database configuration (SQLite WAL by default, or Postgres)
DATABASE_URL=sqlite:///./festos.db

# Authentication and Security
JWT_SECRET=festos-dev-insecure-secret-key-change-in-production
JWT_EXPIRE_MIN=1440
AUTH_DISABLED=true
QR_SECRET=festos-dev-qr-verification-secret

# Time & Clock
FESTOS_TZ=Asia/Kolkata
# FESTOS_NOW=2026-10-30T10:00:00Z  # Optional override for simulated fest time

# Data & Seeding
DATA_DIR=./data
SEED_ON_START=false

# AI & Solver Integrations
LLM_PROVIDER=mock
LLM_API_KEY=
ACCOM_SOLVER=heuristic
SCHED_SOLVER=heuristic

# Frontend & CORS
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
